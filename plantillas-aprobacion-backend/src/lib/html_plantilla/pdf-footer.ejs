<style>
  .pdf-footer {
    width: 100%;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #444;
    box-sizing: border-box;
  }
  .pdf-footer-line {
    width: 100%;
    height: 1.6px;
    background-color: #c4a484;
    margin-bottom: 4px;
    display: block;
    clear: both;
  }
  .pdf-footer-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .pdf-footer-table td {
    padding: 0;
    vertical-align: bottom;
  }
  .pdf-footer-datos {
    text-align: center;
    line-height: 1.35;
    font-size: 7pt;
    color: #444;
  }
  .pdf-footer-pagina {
    width: 45px;
    text-align: right;
    font-size: 9pt;
    font-weight: bold;
    color: #333;
    white-space: nowrap;
  }
</style>

<%
  var footerEntidad = (typeof entidad !== 'undefined' && entidad) ? entidad : {};
%>
<div class="pdf-footer">
  <div class="pdf-footer-line"></div>
  <table class="pdf-footer-table" role="presentation">
    <tr>
      <td class="pdf-footer-datos">
        ZONA PROGRESO, CALLE RAVELO S/N, ENTRE BOLIVAR Y ABAROA, UYUNI - BOLIVIA<br>
        M.C./NIT: 484874028 | TELEFONO: 71617875 | CORREO: contacto@marabuntarl.com<br>
        marabuntarl.com
      </td>
      <td class="pdf-footer-pagina">
        <span class="pageNumber"></span>/<span class="totalPages"></span>
      </td>
    </tr>
  </table>
</div>


