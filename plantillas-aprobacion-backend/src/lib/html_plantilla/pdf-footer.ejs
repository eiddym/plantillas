<style>
  .pdf-footer {
    width: 100%;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 7.5pt;
    color: #333;
    text-align: center;
  }

  .pdf-footer-line {
    width: 100%;
    height: 1.6px;
    background-color: #c4a484;
    margin-bottom: 5px;
  }

  .pdf-footer-datos {
    line-height: 1.3;
  }
</style>

<div class="pdf-footer">
  <div class="pdf-footer-line"></div>

  <div class="pdf-footer-datos">
    <%= (entidad && entidad.direccion) || '' %>

    <% if (entidad && entidad.nit) { %>
      &nbsp;&nbsp;|&nbsp;&nbsp;<%= entidad.nit %>
    <% } %>

    <% if (entidad && entidad.telefono) { %>
      &nbsp;&nbsp;|&nbsp;&nbsp;<%= entidad.telefono %>
    <% } %>

    <% if (entidad && entidad.correo) { %>
      &nbsp;&nbsp;|&nbsp;&nbsp;<%= entidad.correo %>
    <% } %>

    <% if (entidad && entidad.web) { %>
      &nbsp;&nbsp;|&nbsp;&nbsp;<%= entidad.web %>
    <% } %>
  </div>
</div>
