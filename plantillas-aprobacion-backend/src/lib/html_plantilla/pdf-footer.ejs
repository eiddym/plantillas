<style>
  .pdf-footer {
    width: 100%;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 6pt;
    color: #333;
    position: relative;
  }
  .pdf-footer-line {
    width: 100%;
    height: 1.6px;
    background-color: #c4a484;
    margin-bottom: 5px;
  }
  .pdf-footer-datos {
    width: 100%;
    text-align: center;
    line-height: 1.3;
    font-size: 6pt;
    padding-right: 40px; /* deja espacio para que no se solape con la paginación */
  }
  .pdf-footer-pagina {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 8pt;
    text-align: right;
    white-space: nowrap;
  }
</style>

<%
  var footerEntidad = (typeof entidad !== 'undefined' && entidad) ? entidad : {};
%>
<div class="pdf-footer">
  <div class="pdf-footer-line"></div>
  <div class="pdf-footer-datos">
    <%= footerEntidad.direccion || '' %><br>
    <%= footerEntidad.nit || '' %>
    <% if (footerEntidad.telefono) { %>
      &nbsp;|&nbsp; <%= footerEntidad.telefono %>
    <% } %>
    <% if (footerEntidad.correo) { %>
      &nbsp;|&nbsp; <%= footerEntidad.correo %>
    <% } %><br>
    <% if (footerEntidad.web) { %>
      <%= footerEntidad.web %>
    <% } %>
  </div>
  <div class="pdf-footer-pagina">
    {{page}}/{{pages}}
  </div>
</div>
