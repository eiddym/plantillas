<style>
  .pdf-header {
    width: 100%;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9.5pt;
    color: #222;
  }

  .pdf-header-top {
    display: table;
    width: 100%;
    table-layout: fixed;
    margin-bottom: 3px;
  }

  .pdf-header-top > div {
    display: table-cell;
    vertical-align: middle;
  }

  .pdf-header-logo {
    width: 70%;
    text-align: left;
  }

  .pdf-header-logo img {
    height: 32px;
    max-width: 160px;
  }

  .pdf-header-page {
    width: 30%;
    text-align: right;
    font-size: 9pt;
  }

  .pdf-header-line {
    width: 100%;
    height: 1.6px;
    background-color: #c4a484;
    margin: 2px 0 4px 0;
  }

  .pdf-header-info {
    display: table;
    width: 100%;
    table-layout: fixed;
    margin-bottom: 6px;
  }

  .pdf-header-info > div {
    display: table-cell;
    vertical-align: top;
  }

  .pdf-header-meta {
    width: 68%;
    line-height: 1.35;
  }

  .pdf-header-right {
    width: 32%;
    text-align: right;
  }

  .pdf-header-fecha {
    font-size: 9.5pt;
    margin-bottom: 3px;
  }

  .pdf-header-qr img {
    width: 52px;
    height: 52px;
  }

  .pdf-header-qr-caption {
    font-size: 7.5pt;
    color: #555;
    margin-top: 1px;
  }
</style>

<div class="pdf-header">
  <div class="pdf-header-top">
    <div class="pdf-header-logo">
      <% if (logo_base64) { %>
        <img src="<%= logo_base64 %>" alt="Logo institucional">
      <% } %>
    </div>

    <div class="pdf-header-page">
      Página {{page}} de {{pages}}
    </div>
  </div>

  <div class="pdf-header-line"></div>

  <div class="pdf-header-info">
    <div class="pdf-header-meta">
      <%= pdf_cite || '' %><br>
      Expediente : <%= pdf_expediente || '' %><br>
      Código de verificación : <%= pdf_codigo || '' %>
    </div>

    <div class="pdf-header-right">
      <div class="pdf-header-fecha">
        <%= pdf_fecha || '' %>
      </div>

      <% if (qr_base64) { %>
        <div class="pdf-header-qr">
          <img src="<%= qr_base64 %>" alt="Código QR">
          <div class="pdf-header-qr-caption">
            Escanear para verificar
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
