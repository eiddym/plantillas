<div style="width: 100%; box-sizing: border-box; padding: 0 25mm; font-family: 'Open Sans', 'DejaVu Sans', Arial, Helvetica, sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact;">
  <table role="presentation" style="width: 100%; border-collapse: collapse; border-bottom: 1.5pt solid #CAAE92; padding-bottom: 2pt;">
    <tr>
      <td style="width: 15mm; vertical-align: middle; text-align: left; padding: 0 0 2pt 0;">
        <% if (typeof logo_base64 !== 'undefined' && logo_base64) { %>
          <img src="<%= logo_base64 %>" alt="Logo Institucional" style="width: 12mm; height: 12mm; display: block; object-fit: contain;">
        <% } %>
      </td>
      <td style="vertical-align: middle; text-align: center; padding: 0 2px 2pt 2px;">
        <div style="font-size: 8.8pt; font-weight: 700; line-height: 1.15; color: #8B2500; white-space: nowrap; text-align: center; letter-spacing: 0.2px;">
          <%= (typeof entidad !== 'undefined' && entidad && entidad.razon_social) ? entidad.razon_social : 'COOPERATIVA MINERA MARABUNTA R.L.' %>
        </div>
        <div style="font-size: 6.2pt; font-weight: 700; line-height: 8pt; margin-top: 1px; white-space: nowrap; text-align: center; color: #111;">
          <%= (typeof entidad !== 'undefined' && entidad && entidad.personeria_juridica) ? entidad.personeria_juridica : 'P.J. 483/2025, R.E.C. 01.01.2760' %>
        </div>
        <div style="font-size: 5pt; font-weight: 700; line-height: 6.8pt; margin-top: 1px; white-space: nowrap; text-align: center; color: #111;">
          <%= (typeof entidad !== 'undefined' && entidad && entidad.afiliacion) ? entidad.afiliacion : 'AFILIADA A LA FEDERACIÓN REGIONAL DE COOPERATIVAS MINERAS DEL SUD R.L. UYUNI' %>
        </div>
      </td>
      <td style="width: 15mm; vertical-align: middle; text-align: right; padding: 0 0 2pt 0;">
        <% if (typeof logo_ferecomin_base64 !== 'undefined' && logo_ferecomin_base64) { %>
          <img src="<%= logo_ferecomin_base64 %>" alt="Logo FERECOMIN" style="width: 12mm; height: 12mm; display: block; object-fit: contain; margin-left: auto;">
        <% } else if (typeof logo_base64 !== 'undefined' && logo_base64) { %>
          <img src="<%= logo_base64 %>" alt="Logo FERECOMIN" style="width: 12mm; height: 12mm; display: block; object-fit: contain; margin-left: auto;">
        <% } %>
      </td>
    </tr>
  </table>
</div>