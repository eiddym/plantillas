        line-height: 1;
      }
      .membrete-personeria {
        margin-top: 2px;
      }
      .membrete-afiliacion {
        margin-top: 1px;
      }

.membrete-personeria {
        margin-top: 1px;
      }
      .membrete-afiliacion {
        margin-top: 0;
      }

      .cabecera-linea {
        width: 100%;
        height: 1.6px;
        background-color: #c4a484;
        margin: 4px 0 6px 0;
      }
      .cabecera-info {
        display: table;
        width: 100%;
        table-layout: fixed;
      }
      .cabecera-info > div {
        display: table-cell;
        vertical-align: top;
      }
      .cabecera-meta {
        width: 68%;
        line-height: 1.35;
      }
      .cabecera-right {
        width: 32%;
        text-align: center;
      }
      .cabecera-fecha {
        margin-bottom: 4px;
        text-align: center;
        font-size: 7pt;
      }
      .cabecera-qr {
        display: inline-block;
        text-align: center;
      }
      .cabecera-qr img {
        width: 68px !important;
        height: 68px !important;
        display: block !important;
        margin: 0 auto;
      }
      .cabecera-qr-caption {
        font-size: 7pt;
        color: #555;
        margin-top: 2px;
        text-align: center;
        white-space: nowrap;
      }
      .cuerpo-documento {
        position: relative;
        margin-top: -135px;
        padding-top: 0;
      }
      .cuerpo-documento,
      .cuerpo-documento * {
        font-family: 'Open Sans', Arial, Helvetica, sans-serif !important;
      }
      .cuerpo-documento h1,
      .cuerpo-documento h2,
      .cuerpo-documento h3,
