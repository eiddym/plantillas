      }
      .urlVerificacion{
        color: inherit;
        text-decoration: none;
        cursor: pointer;
      }
      .td-alinear-derecha {
        /* text-align: right; */
        width: auto;
        height: auto;
        vertical-align: top;
      }
      .td-alinear-izquierda {
        text-align: left;
