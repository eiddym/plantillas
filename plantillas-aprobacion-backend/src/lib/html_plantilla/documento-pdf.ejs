      /*
       * El título queda centrado dentro del ancho útil de la hoja.
       * Permanece en el flujo, por lo que PARA/DE/REF empieza debajo.
       */
      .cuerpo-documento > .contenedor > h2 {
        clear: both;
        width: 100%;
        margin: -52px 0 10px 0;
        text-align: center;
        font-family: 'Open Sans', Arial, Helvetica, sans-serif;
        font-size: 13pt;
        line-height: 1.1;
      }

      /*
       * El header anterior está duplicado por la cabecera simulada.
       * Se oculta sin afectar la cabecera nueva.
       */
      .cuerpo-documento #pageHeader {
        display: none;
      }

      /*
       * Quita el espacio de contenedores vacíos entre título y datos.
       */
      .cuerpo-documento > .contenedor:empty {
        display: none;
      }
      .cuerpo-documento h1 {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        margin: 0;
        text-align: center;
      }
